# Do not run dependency lifecycle scripts. The docs build does not need any of
# them, and an install script is the usual way a compromised package gains
# execution in CI.
ignore-scripts=true

# Only resolve versions published more than 14 days ago, so a freshly published
# compromised release cannot enter package-lock.json. This binds when
# dependencies are updated; CI installs from the lockfile with npm ci.
min-release-age=14
